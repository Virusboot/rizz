rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfile(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 50
        && d.gender in ['man', 'woman', 'nonbinary']
        && d.interestedIn in ['men', 'women', 'everyone']
        && d.intent in ['dating', 'casual', 'both']
        && d.city is string && d.city.size() <= 60
        && d.photos is list && d.photos.size() >= 1 && d.photos.size() <= 6
        && d.prompts is list && d.prompts.size() <= 3
        && d.ageMin is int && d.ageMax is int
        && d.ageMin >= 18 && d.ageMax <= 99;
    }

    function otherUser(users) {
      return users[0] == request.auth.uid ? users[1] : users[0];
    }

    // ------------------------------------------------------------- users
    match /users/{uid} {
      allow get: if isOwner(uid)
        || (signedIn() && resource.data.onboarded == true);
      allow list: if signedIn() && resource.data.onboarded == true;

      // Users cannot verify themselves. `verified` is set from the console.
      allow create: if isOwner(uid)
        && request.resource.data.onboarded == true
        && request.resource.data.verified == false
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && validProfile(request.resource.data);

      allow update: if isOwner(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.age >= 18
        && request.resource.data.age >= resource.data.age
        && validProfile(request.resource.data);

      allow delete: if isOwner(uid);

      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }

      match /passes/{target} {
        allow read, write: if isOwner(uid);
      }

      // Push notification tokens of this user's phones.
      match /tokens/{token} {
        allow read, write: if isOwner(uid);
      }
    }

    // ------------------------------------------------------------- likes
    match /likes/{likeId} {
      allow get: if signedIn()
        && (likeId.split('_')[0] == request.auth.uid
            || likeId.split('_')[1] == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.to
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + request.resource.data.to));
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
    }

    // ----------------------------------------------------------- matches
    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;

      // A match can only be created when the other person already liked me.
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && exists(/databases/$(database)/documents/likes/$(otherUser(request.resource.data.users) + '_' + request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(otherUser(request.resource.data.users) + '_' + request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + otherUser(request.resource.data.users)));

      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastSender', 'lastMessageAt']);

      allow delete: if signedIn() && request.auth.uid in resource.data.users;

      match /messages/{msgId} {
        allow read, delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;

        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
      }
    }

    // ------------------------------------------------------------ blocks
    match /blocks/{blockId} {
      // Only the person who blocked can see the block. Blocked people must
      // not be able to find out who blocked them.
      allow list: if signedIn() && resource.data.blocker == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.blocker == request.auth.uid
        && request.resource.data.blocked is string
        && blockId == request.auth.uid + '_' + request.resource.data.blocked;
      allow delete: if signedIn() && resource.data.blocker == request.auth.uid;
    }

    // ----------------------------------------------------------- reports
    // Write only. Reports are read by the team in the Firebase console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporter == request.auth.uid;
    }
  }
}
